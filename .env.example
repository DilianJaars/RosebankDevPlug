# Public — safe to expose in the browser (protected by RLS, not by secrecy)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — server-only. Never prefix with NEXT_PUBLIC_. Bypasses all RLS.
# Used only in app/api/admin-login/route.ts for the login-attempt lockout table.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL, used to build the OAuth redirect — set to your real domain in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payfast — get these from your Payfast merchant dashboard
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=46f0cd694581a
PAYFAST_PASSPHRASE=
PAYFAST_MODE=sandbox
